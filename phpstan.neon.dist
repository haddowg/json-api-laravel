includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 9
    paths:
        - src
        - tests
        - workbench
    bootstrapFiles:
        # Registers the testing kit's TestResponse macros so larastan resolves them at
        # every call site (its macro detection reflects the live Macroable::$macros).
        - phpstan-bootstrap.php
    tmpDir: .phpstan.cache
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Laravel types orderByRaw() $sql as `literal-string` to guard against SQL
        # injection. The forced NULL=largest keyset ORDER BY (`CASE WHEN col IS NULL
        # …`) has no query-builder equivalent — Laravel has no `orderByNullsLast`, and
        # `NULLS LAST` is not portable (MySQL/SQLite lack it) — so it must interpolate a
        # column into a raw CASE. That column is a regex-validated identifier qualified
        # off the model's own table (never client input) and no value is interpolated,
        # so the guard is a false positive here. Scoped to this one call so any other
        # raw-SQL argument.type error still surfaces.
        -
            message: '#^Parameter \#1 \$sql of method Illuminate\\Database\\Eloquent\\Builder<.*>::orderByRaw\(\) expects .*literal-string.*$#'
            path: src/DataProvider/Eloquent/EloquentKeyset.php
        # Laravel types whereRaw() $sql as `literal-string` for the same SQL-injection
        # guard. The wildcard-LIKE fragment (`lower(col) LIKE ? ESCAPE '!'`)
        # interpolates only a regex-validated identifier qualified off the model's
        # own table (never client input) and binds the search value — so the guard is a
        # false positive. Scoped to this one call so any other raw-SQL argument.type
        # error still surfaces.
        -
            message: '#^Parameter \#1 \$sql of method Illuminate\\Database\\Eloquent\\Builder<.*>::whereRaw\(\) expects .*literal-string.*$#'
            path: src/DataProvider/Eloquent/EloquentFilterHandler.php
        # The keyset WHERE for a custom sort compares the expression its Eloquent arm
        # supplies, which is server-authored SQL like a declared column, and binds the
        # boundary value. Scoped to this file for the same reason as above.
        -
            message: '#^Parameter \#1 \$sql of method Illuminate\\Database\\Eloquent\\Builder<.*>::(or)?whereRaw\(\) expects .*literal-string.*$#i'
            path: src/DataProvider/Eloquent/EloquentKeyset.php
        # The workbench placeholder-value arm names its join alias after a regex-validated
        # placeholder, so its sort expression is built rather than literal.
        -
            message: '#^Parameter \#1 \$value of class Illuminate\\Database\\Query\\Expression constructor expects .*literal-string.*$#'
            path: workbench/app/SortFamily/PlaceholderValueEloquentArm.php
        # The UrlGenerator contract's route() declares only InvalidArgumentException, but
        # the concrete generator throws UrlGenerationException when a route has unfilled
        # parameters (a document route under a parameterised prefix). The catch guards
        # that real path, so dropping it would turn a missing parameter into a 500.
        -
            identifier: catch.neverThrown
            message: '#UrlGenerationException is never thrown#'
            paths:
                - src/OpenApi/DocumentUrlProvider.php
                - src/OpenApi/DocumentRouteLocator.php
                - src/OpenApi/OpenApiDocumentUrls.php
