#!/usr/bin/env node
/**
 * Fails unless package.json pins @haddowg/json-api-symfony-specs, the bundle documents
 * `composer byte-compat` diffs against, to one published version:
 *   - devDependencies pins an exact X.Y.Z, with no range, dist-tag, file:, link: or URL;
 *   - the pin is not a prerelease, unless --allow-prerelease is passed;
 *   - package-lock.json locks that version, and resolves it, if it records where from,
 *     from https://npm.pkg.github.com/;
 *   - the registry has that version published.
 *
 * A feature pull request may pin a bundle pull request's prerelease (0.0.0-pr.<n>.<sha7>)
 * while it waits for the bundle to release, so CI passes --allow-prerelease there. On main
 * and on release pull requests it does not, so a release always pins a bundle release.
 *
 * Usage: bin/check-specs-pin [--allow-prerelease] [dir]   (dir defaults to the repo root)
 * The registry lookup needs read access to GitHub Packages, e.g.
 *   export NODE_AUTH_TOKEN="$(gh auth token)"
 *   export NPM_CONFIG_USERCONFIG="$(.github/scripts/npm-auth)"
 */
const { readFileSync } = require('node:fs');
const { join, resolve } = require('node:path');
const { execFileSync } = require('node:child_process');

const NAME = '@haddowg/json-api-symfony-specs';
const REGISTRY = 'https://npm.pkg.github.com';
const RELEASE = /^\d+\.\d+\.\d+$/;
const PRERELEASE = /^\d+\.\d+\.\d+-[0-9A-Za-z.-]+$/;

const args = process.argv.slice(2);
const allowPrerelease = args.includes('--allow-prerelease');
const dir = resolve(args.find((arg) => !arg.startsWith('--')) ?? join(__dirname, '..'));

const fail = (message) => {
  console.error(`check-specs-pin: ${message}`);
  console.error('See docs/workbench.md#byte-compatibility for how to pin the bundle documents.');
  process.exit(1);
};

const readJson = (file) => {
  try {
    return JSON.parse(readFileSync(join(dir, file), 'utf8'));
  } catch (error) {
    fail(`can't read ${file}: ${error.message}`);
  }
};

const describe = (spec) => {
  if (/^(file|link):/.test(spec)) return 'a local path';
  if (/^(git|github|gitlab|bitbucket)[:+]|^[\w.-]+\/[\w.-]+(#.*)?$|\.git(#.*)?$/.test(spec))
    return 'a git URL';
  if (/^https?:/.test(spec)) return 'a URL';
  if (/^v\d+\.\d+\.\d+/.test(spec)) return 'a version with a leading v';
  if (/^[a-z][\w.-]*$/i.test(spec)) return 'a dist-tag';
  return 'a range';
};

const pkg = readJson('package.json');
const pin = pkg.devDependencies?.[NAME];
if (pin === undefined) {
  fail(
    pkg.dependencies?.[NAME] !== undefined
      ? `${NAME} is in dependencies; pin it in devDependencies`
      : `package.json doesn't pin ${NAME} in devDependencies`
  );
}
if (PRERELEASE.test(pin)) {
  if (!allowPrerelease) {
    fail(
      `package.json pins ${NAME} to the prerelease "${pin}", which only a feature pull request may pin. Pin a json-api-symfony release, X.Y.Z.`
    );
  }
} else if (!RELEASE.test(pin)) {
  fail(`package.json pins ${NAME} to "${pin}", ${describe(pin)}. Pin an exact version.`);
}

const locked = readJson('package-lock.json').packages?.[`node_modules/${NAME}`];
if (locked === undefined) {
  fail(`package-lock.json has no ${NAME}. Run npm install to update it.`);
}
if (locked.version !== pin) {
  fail(`package-lock.json has ${NAME}@${locked.version}, but package.json pins ${pin}. Run npm install.`);
}
if (locked.resolved !== undefined && !String(locked.resolved).startsWith(`${REGISTRY}/`)) {
  fail(`package-lock.json resolves ${NAME} from ${locked.resolved}, not ${REGISTRY}/`);
}

let published;
try {
  published = execFileSync('npm', ['view', `${NAME}@${pin}`, 'version', '--registry', REGISTRY], {
    cwd: dir,
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe']
  }).trim();
} catch (error) {
  const output = String(error.stderr || error.message);
  if (/\bE40[134]\b/.test(output)) {
    fail(`${NAME}@${pin} isn't published in ${REGISTRY}, or the npm token can't read it:\n${output}`);
  }
  fail(`npm view ${NAME}@${pin} failed:\n${output}`);
}
if (published !== pin) {
  fail(`${NAME}@${pin} isn't published in ${REGISTRY}`);
}

console.log(`check-specs-pin: ${NAME}@${pin} is published${PRERELEASE.test(pin) ? ' (a prerelease)' : ''}`);
